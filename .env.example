# For self-hosting with Docker. The Modal-hosted gateway needs none of this: run `modal-bridge deploy`.
# Generate your own gateway token: openssl rand -hex 32
BRIDGE_TOKEN=replace-with-at-least-32-random-characters
BRIDGE_TARGETS={"square":["modal-bridge-example","square"]}
MODAL_TOKEN_ID=replace-with-your-modal-token-id
MODAL_TOKEN_SECRET=replace-with-your-modal-token-secret

# Required for completion callbacks. Generate: echo "whsec_$(openssl rand -base64 32)"
BRIDGE_WEBHOOK_SECRET=
# Optional. Comma-separated callback hosts, e.g. my-app.dev,*.workers.dev
BRIDGE_CALLBACK_HOSTS=
# Optional. Per Bridge-Owner caps on unfinished jobs and jobs per 24 hours.
BRIDGE_OWNER_MAX_ACTIVE=
BRIDGE_OWNER_MAX_DAILY=
# Optional. Delete settled jobs after this many days; their idempotency keys become reusable.
BRIDGE_RETENTION_DAYS=
# Optional. Concurrent Modal SDK calls per gateway process (default 32).
BRIDGE_MAX_MODAL_CONCURRENCY=
