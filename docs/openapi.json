  },
  "components": {
    "schemas": {
      "APIError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "APIError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "Health"
      },
      "Item": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Key"
          },
          "input": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "input"
        ],
        "title": "Item"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Gateway job ID; distinct from a Modal call ID"
          },
          "function": {
            "type": "string",
            "title": "Function",
            "description": "Allowlisted function alias"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitting",
              "submission_unknown",
              "pending",
              "succeeded",
              "failed",
              "expired",
              "cancel_requested"
            ],
            "title": "Status"
          },
          "result": {
            "$ref": "#/components/schemas/JsonValue",
            "description": "Present on success; JSON null is a valid result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Sanitized failure description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "function",
          "status"
        ],
        "title": "Job",
        "description": "A durable gateway job. `pending` includes both queued and running work.",
        "examples": [
          {
            "function": "square",
            "id": "a7bdf038-4594-4a30-b498-367005e7b561",
            "status": "pending"
          },
          {
            "function": "square",
            "id": "a7bdf038-4594-4a30-b498-367005e7b561",
            "result": {
              "value": 144
            },
            "status": "succeeded"
          }
        ]
      },
      "JsonValue": {},
      "Preview": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "reusable": {
            "type": "integer",
            "title": "Reusable"
          },
          "to_compute": {
            "type": "integer",
            "title": "To Compute"
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "reusable",
          "to_compute",
          "items"
        ],
        "title": "Preview"
      },
      "Replay": {
        "properties": {
          "keys": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 1000,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Keys"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Replay"
      },
      "RunSpec": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "function": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Function"
          },
          "revision": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Revision",
            "description": "Change when code, model, prompts or preprocessing change"
          },
          "namespace": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Namespace",
            "default": "default"
          },
          "max_in_flight": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Max In Flight",
            "default": 4
          },
          "reuse_successes": {
            "type": "boolean",
            "title": "Reuse Successes",
            "default": true
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "function",
          "revision",
          "items"
        ],
        "title": "RunSpec",
        "examples": [
          {
            "function": "documents",
            "items": [
              {
                "input": {
                  "text": "Our handbook explains how we work."
                },
                "key": "intro"
              }
            ],
            "max_in_flight": 2,
            "name": "handbook",
            "namespace": "handbook",
            "revision": "bge-small-chunks-v1"
          }
        ]
      },
      "RunView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "function": {
            "type": "string",
            "title": "Function"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "namespace": {
            "type": "string",
            "title": "Namespace"
          },
          "mode": {
            "type": "string",
            "enum": [
              "active",
              "paused"
            ],
            "title": "Mode"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "paused",
              "needs_attention",
              "completed"
            ],
            "title": "Status"
          },
          "max_in_flight": {
            "type": "integer",
            "title": "Max In Flight"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "function",
          "revision",
          "namespace",
          "mode",
          "status",
          "max_in_flight",
          "counts",
          "total",
          "created_at"
        ],
        "title": "RunView"
      },
      "Submission": {
        "properties": {
          "function": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Function"
          },
          "input": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "function",
          "input"
        ],
        "title": "Submission",
        "examples": [
          {
            "function": "square",
            "input": {
              "value": 12
            }
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
