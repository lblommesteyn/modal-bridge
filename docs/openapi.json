    "/v1/runs/{run_id}/retry-failed": {
      "post": {
        "tags": [
          "Runs"
        ],
        "summary": "Retry confirmed failures, preserving successes and attempt history",
        "operationId": "retry_v1_runs__run_id__retry_failed_post",
        "security": [
          {
            "GatewayToken": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
