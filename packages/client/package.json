{
  "name": "@modal-bridge/client",
  "version": "0.2.0",
  "description": "Fetch-only typed client for Modal Bridge: run Modal jobs from Cloudflare Workers and other edge runtimes",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lblommesteyn/modal-bridge.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/lblommesteyn/modal-bridge#readme",
  "bugs": {
    "url": "https://github.com/lblommesteyn/modal-bridge/issues"
  },
  "keywords": [
    "modal",
    "cloudflare-workers",
    "edge",
    "gpu",
    "jobs",
    "webhooks",
    "idempotency",
    "fetch"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
