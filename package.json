{
  "name": "modal-bridge-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/client",
    "packages/create-modal-bridge",
    "examples/worker",
    "examples/image-gen"
  ],
  "scripts": {
    "build": "tsc -p packages/client && tsc -p examples/worker --noEmit && tsc -p examples/image-gen",
    "test": "npm run build && node --test packages/client/test/*.test.mjs",
    "test:workers": "node --test packages/client/test/workers.integration.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261109.0-beta",
    "typescript": "^5.9.3"
  }
}
